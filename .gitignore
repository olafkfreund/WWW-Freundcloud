# Jekyll build output & caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Pagefind index (generated at build time)
pagefind/

# Ruby / Bundler
vendor/
.bundle/
*.gem
# NOTE: Gemfile.lock IS committed — it pins sass-embedded to a version that
# still inlines legacy @import. A fresh CI resolve picks dart-sass >=2.0 which
# passes @import through as plain CSS, shipping an unstyled site.

# Node
node_modules/

# OS
.DS_Store

# NotebookLM source audio (257 kbps stereo originals).
# The site ships re-encoded 96k mono copies in assets/audio/podcasts/;
# these masters stay local so git history is not carrying 228 MB forever.
/podcasts/
